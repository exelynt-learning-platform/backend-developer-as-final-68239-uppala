# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JWT Security Configuration (Required: Provide a unique, secure secret of at least 32 bytes)
JWT_SECRET=your_unique_secure_jwt_secret_key_minimum_32_bytes
JWT_EXPIRATION_MS=86400000

# Seed Account Passwords
ADMIN_SEED_PASSWORD=your_admin_password
USER_SEED_PASSWORD=your_user_password

# Server Port
SERVER_PORT=8081
